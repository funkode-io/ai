#!/usr/bin/env python3
"""Entry point for the Herdr status bar plugin.

Kept dependency-free and stdlib-only: this runs on the Herdr server's PATH,
on every status bar refresh tick, so start-up cost matters.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from herdr_status.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
